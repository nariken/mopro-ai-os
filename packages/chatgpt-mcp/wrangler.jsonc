{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mopro-chatgpt-mcp",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    {
      "binding": "MOPRO_GATEWAY",
      "service": "workshop-backend",
      "entrypoint": "ExternalMessageGateway",
      "props": { "source": "chatgpt" }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
