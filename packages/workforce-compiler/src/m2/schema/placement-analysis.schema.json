{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mopro.ai/schemas/workforce-placement-analysis/2.0.0.json",
  "title": "WorkforcePlacementAnalysis",
  "type": "object",
  "required": [
    "schemaVersion",
    "analysisId",
    "analysisVersion",
    "ruleSetVersion",
    "generatedAt",
    "evaluationHorizonYears",
    "definitionRef",
    "provenance",
    "scopeTaskIds",
    "taskAnalyses",
    "humanSelections"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "analysisId": { "type": "string", "minLength": 1 },
    "analysisVersion": { "type": "string", "minLength": 1 },
    "ruleSetVersion": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "evaluationHorizonYears": { "type": "integer", "enum": [1, 2, 3] },
    "definitionRef": {
      "type": "object",
      "required": ["definitionId", "schemaVersion", "contentDigest"],
      "properties": {
        "definitionId": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": "1.0.0" },
        "contentDigest": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" }
      }
    },
    "provenance": { "type": "object" },
    "scopeTaskIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "taskAnalyses": { "type": "array", "minItems": 1 },
    "humanSelections": { "type": "array" }
  }
}
